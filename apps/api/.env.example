# Sin DATABASE_URL la API usa una base local PGlite en .pglite/
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/tekluma?sslmode=require

# URL pública de la API (Better Auth la usa para callbacks)
BETTER_AUTH_URL=http://localhost:8787
# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Correos: en AWS se envían con SES (CORREO_PROVEEDOR=ses lo define sst.config.ts).
# En local, sin esa variable, el código de login se imprime en consola.

# Opcional: login social
# APPLE_CLIENT_ID=app.tekluma
# APPLE_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Cupo diario (opcional; estos son los valores por defecto)
# CUPO_GRATIS=15
# CUPO_BIENVENIDA=30
# CUPO_DIAS_BIENVENIDA=3
# CUPO_TARJETAS_POR_ANUNCIO=5
# CUPO_MAX_ANUNCIOS_DIA=8
# CUPO_MAX_INTERSTICIALES_DIA=2
# CUPO_TARJETAS_POR_COMPRA_MONEDAS=5

# RevenueCat: clave secreta (API v1) y el valor del header Authorization del webhook
# REVENUECAT_SECRET_KEY=sk_...
# REVENUECAT_WEBHOOK_SECRET=
