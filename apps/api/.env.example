# Sin DATABASE_URL la API usa una base local PGlite en .pglite/
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/tekluma?sslmode=require

# URL pública de la API (Better Auth la usa para callbacks)
BETTER_AUTH_URL=http://localhost:8787
# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Opcional: envío real de códigos por correo (si falta, el código se imprime en consola)
# RESEND_API_KEY=
# CORREO_REMITENTE="Tekluma <hola@tekluma.app>"

# Opcional: login social
# APPLE_CLIENT_ID=app.tekluma
# APPLE_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
