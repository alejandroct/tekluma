# URL de la API (en el simulador basta localhost)
EXPO_PUBLIC_API_URL=http://localhost:8787

# Bloques de anuncios de AdMob para producción (en desarrollo se usan los de prueba de Google)
# EXPO_PUBLIC_ADMOB_RECOMPENSA_IOS=ca-app-pub-xxx/yyy
# EXPO_PUBLIC_ADMOB_INTERSTICIAL_IOS=ca-app-pub-xxx/yyy
# EXPO_PUBLIC_ADMOB_RECOMPENSA_ANDROID=ca-app-pub-xxx/yyy
# EXPO_PUBLIC_ADMOB_INTERSTICIAL_ANDROID=ca-app-pub-xxx/yyy

# RevenueCat: claves públicas del SDK (Project settings → API keys)
# EXPO_PUBLIC_REVENUECAT_IOS=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID=goog_...
